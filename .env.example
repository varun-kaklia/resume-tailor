# ResumeTailor — development environment
#
# THIS FILE IS FOR LOCAL DEVELOPMENT TOOLING ONLY.
#
# The shipped extension has no .env and reads no environment variables. Your API
# key lives in browser extension storage, entered through the options page.
# These values exist so contributors can run scripts and integration tests
# without clicking through the UI every time.
#
# Copy to `.env.local` (gitignored) and fill in. Never commit a real key.

# --- Test provider ---------------------------------------------------------
# Used by scripts and opt-in integration tests. Unit tests use fixtures and
# need none of this.

# openai | anthropic | gemini | openai-compatible
RT_DEV_PROVIDER=openai

# Model id, as your vendor spells it.
RT_DEV_MODEL=gpt-4o-mini

# Your key. `.env.local` only. Use one with a spending limit.
RT_DEV_API_KEY=

# Only for openai-compatible: Ollama, LM Studio, OpenRouter, a proxy.
# Ollama default: http://localhost:11434/v1
RT_DEV_BASE_URL=

# --- Build -----------------------------------------------------------------

# chrome | firefox | edge
RT_TARGET=chrome

# Extra logging in the service worker. Never enable for a release build.
RT_DEBUG=false

# --- Integration tests -----------------------------------------------------

# Set to `true` to run tests that make real, paid API calls. Off by default,
# and off in CI.
RT_RUN_LIVE_TESTS=false
